// Hand-maintained. CircleCI generation is switched off for this repo in
// giantswarm/github (gen.ci.generate: false), so align-files does not
// regenerate this file; it only keeps `reviewers` below in sync. Rules for a
// whole class of repos belong in giantswarm/renovate-presets instead.
{
  extends: [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    'github>giantswarm/renovate-presets:default.json5',
    // Go specific config - https://github.com/giantswarm/renovate-presets/blob/main/lang-go.json5
    'github>giantswarm/renovate-presets:lang-go.json5',
  ],
  // Commits the generated workflows push onto Renovate branches are made as
  // taylorbot <dev@giantswarm.io> (zz_generated.helm-docs-regen.yaml, the
  // update-chart and sync-from-upstream flows). Renovate treats a branch whose
  // last commit is by anyone else as edited by a human: it stops rebasing it
  // and, on autoclose, retitles the PR "- abandoned" instead of closing it.
  // Listing the author here makes those commits Renovate's own. Renovate
  // compares the author email, so this is the bare address.
  gitIgnoredAuthors: [
    'dev@giantswarm.io',
  ],
  reviewers: ['teemow'],
  // Assign the configured reviewers even to PRs Renovate auto-merges, so they
  // are still requested for review. Without this Renovate skips review
  // requests on auto-merged PRs.
  assignAutomerge: true,
}
