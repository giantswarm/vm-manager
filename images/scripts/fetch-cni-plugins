#!/usr/bin/env bash
# Download and verify the plugins of one CNI release and stage them as the
# tree the cni sysext is built from (ExtraTrees= of mkosi.images/cni/mkosi.conf):
#
#   fetch-cni-plugins <cni-version> <cache> <tree>
#     <cache>/<asset>                 the release's asset, kept while it verifies
#     <tree>/usr/lib/cni/<plugin>     every plugin of the entry, mode 0755
#
# <cni-version> is "<name>-<release without v>" ("flannel-1.9.1-flannel3");
# cni/<name> is the entry that pins the release, the asset and its sha256
# (see cni/flannel). A version the entry does not pin is refused: the entry is
# the one place a release is chosen. The tree is recreated on every run, so it
# holds exactly the plugins of this version.
set -euo pipefail

version="${1:?cni version (<name>-<release>)}" cache="${2:?cache dir}" tree="${3:?tree dir}"
here="$(cd "$(dirname "$0")/.." && pwd)"
name="${version%%-*}"
entry="$here/cni/$name"
fail() { echo "fetch-cni-plugins: $*" >&2; exit 1; }

[[ "$name" != "$version" && -f "$entry" ]] || fail "no entry cni/$name for $version (entries: $(ls "$here/cni" | tr '\n' ' '))"
release="" url="" sha256="" plugins=""
# shellcheck source=/dev/null
. "$entry"
[[ -n "$release" && -n "$url" && -n "$sha256" && -n "$plugins" ]] || fail "cni/$name must set release, url, sha256 and plugins"
[[ "$name-${release#v}" == "$version" ]] || fail "cni/$name pins $name-${release#v}, not $version"

mkdir -p "$cache"
asset="$cache/${url##*/}"
if [[ -s "$asset" ]] && echo "$sha256  $asset" | sha256sum --quiet -c 2>/dev/null; then
        echo "fetch-cni-plugins: ${asset##*/} of $version present and verified"
else
        rm -f "$asset"
        curl -fsSL --retry 3 -o "$asset.part" "$url" || fail "cannot download $url"
        got="$(sha256sum "$asset.part" | cut -d' ' -f1)"
        if [[ "$got" != "$sha256" ]]; then
                rm -f "$asset.part"
                fail "$url has sha256 $got, cni/$name pins $sha256; a new release needs its sha256 in cni/$name"
        fi
        mv "$asset.part" "$asset"
        echo "fetch-cni-plugins: downloaded ${asset##*/} of $version, sha256 $sha256"
fi

rm -rf "$tree"
install -d "$tree/usr/lib/cni"
case "$asset" in
*.tar.gz | *.tgz)
        unpacked="$cache/unpacked"
        rm -rf "$unpacked" && mkdir -p "$unpacked"
        tar -xzf "$asset" -C "$unpacked"
        for p in $plugins; do
                member="${p%%:*}" plugin="${p##*:}"
                [[ -f "$unpacked/$member" ]] || fail "${asset##*/} has no $member"
                install -m0755 "$unpacked/$member" "$tree/usr/lib/cni/${plugin##*/}"
        done
        ;;
*)
        read -ra list <<<"$plugins"
        [[ ${#list[@]} -eq 1 ]] || fail "cni/$name: a single-binary asset installs as one plugin, got: $plugins"
        install -m0755 "$asset" "$tree/usr/lib/cni/${list[0]}"
        ;;
esac
for f in "$tree"/usr/lib/cni/*; do
        file -b "$f" | /usr/bin/grep -q '^ELF 64-bit LSB .*x86-64' || fail "${f#"$tree"} is not an x86-64 ELF executable: $(file -b "$f")"
done
echo "fetch-cni-plugins: $version: $(cd "$tree" && ls usr/lib/cni | sed 's|^|/usr/lib/cni/|' | tr '\n' ' ')"
