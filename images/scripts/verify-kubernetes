#!/usr/bin/env bash
# Offline verification of the kubernetes sysext. No root, no boot: the DDI is
# read with sfdisk and systemd-dissect --validate, the erofs is extracted with
# fsck.erofs, and the extension is merged onto the base tree with systemd-sysext
# in an unprivileged user namespace (directory form of the extension; loop
# devices for the DDI itself need root). Writes the expected PCR 13 of a guest
# running this version into build/policy.json (pcr13.<version>, step 10).
set -euo pipefail

build="${1:?build dir}" version="${2:?kubernetes version}" keys="${3:?keys dir}"
name="kubernetes_$version"
img="$build/$name.raw"
base="$build/base"
sysupdate="$build/sysupdate/kubernetes"
transfer="$base/usr/lib/sysupdate.kubernetes.d/50-kubernetes.transfer"

tmp="$(mktemp -d)"
trap 'chmod -R u+rwX "$tmp" 2>/dev/null; rm -rf "$tmp"' EXIT
fail() { echo "verify-kubernetes: FAIL: $*" >&2; exit 1; }
ok() { echo "verify-kubernetes: ok: $*"; }

for f in "$img" "$build/$name.roothash" "$base/usr/lib/os-release" "$transfer" "$sysupdate/$name.raw" "$sysupdate/SHA256SUMS.gpg"; do
        [[ -s "$f" ]] || fail "$f missing (run make base kubernetes)"
done
roothash="$(tr -d '\n' <"$build/$name.roothash")"
[[ ${#roothash} -eq 64 ]] || fail "roothash $roothash is not a sha256"

# 1. Partition table: root, verity, signature and nothing else (a sysext DDI
#    has no ESP); root/verity UUIDs derived from the root hash as for the disk.
sfdisk --json "$img" >| "$tmp/sfdisk.json"
eval "$(python3 - "$tmp/sfdisk.json" "$roothash" <<'EOF'
import json, sys
types = {
    "4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709": "root",
    "2C7357ED-EBD2-46D9-AEC1-23D437EC2BF5": "verity",
    "41092B05-9FC8-4523-994F-2DEF0408B176": "sig",
}
table = json.load(open(sys.argv[1]))["partitiontable"]
sector = table.get("sectorsize", 512)
parts = {}
for p in table["partitions"]:
    d = types.get(p["type"].upper())
    if not d:
        sys.exit(f"verify-kubernetes: FAIL: unexpected partition type {p['type']} in sysext")
    parts[d] = p
missing = [d for d in types.values() if d not in parts]
if missing:
    sys.exit(f"verify-kubernetes: FAIL: sysext lacks {missing} partition")
roothash = sys.argv[2]
hexuuid = lambda p: p["uuid"].replace("-", "").lower()
if hexuuid(parts["root"]) != roothash[:32] or hexuuid(parts["verity"]) != roothash[32:]:
    sys.exit("verify-kubernetes: FAIL: root/verity partition UUIDs are not derived from the roothash")
for d, p in parts.items():
    print(f"{d}_offset={p['start'] * sector} {d}_size={p['size'] * sector}")
EOF
)"
ok "partitions root/verity/sig only, root/verity UUIDs match roothash halves"

# 2. systemd-dissect accepts it under a policy that demands signed verity for
#    root and no /usr partition (the default sysext policy is more permissive).
systemd-dissect --validate --image-policy=root=signed:usr=absent "$img" >/dev/null || fail "systemd-dissect --validate rejects $img"
ok "systemd-dissect --validate (root=signed:usr=absent)"

# 3. Signature partition: the JSON root hash is ours and the signing
#    certificate is the verity certificate of this key set (what the base image
#    trusts in /usr/lib/verity.d/).
dd if="$img" bs=512 skip=$((sig_offset / 512)) count=$((sig_size / 512)) status=none | tr -d '\000' >| "$tmp/sig.json"
fingerprint="$(openssl x509 -in "$keys/verity.crt" -noout -fingerprint -sha256 | sed 's/.*=//; s/://g' | tr 'A-F' 'a-f')"
python3 - "$tmp/sig.json" "$roothash" "$fingerprint" <<'EOF'
import json, sys
sig = json.load(open(sys.argv[1]))
if sig["rootHash"] != sys.argv[2]:
    sys.exit(f"verify-kubernetes: FAIL: signature is for root hash {sig['rootHash']}, image has {sys.argv[2]}")
if sig["certificateFingerprint"].lower() != sys.argv[3]:
    sys.exit(f"verify-kubernetes: FAIL: signed with certificate {sig['certificateFingerprint']}, keys/verity.crt is {sys.argv[3]}")
EOF
[[ -s "$base/usr/lib/verity.d/verity.crt" ]] && cmp -s "$base/usr/lib/verity.d/verity.crt" "$keys/verity.crt" \
        || fail "base tree does not trust $keys/verity.crt in /usr/lib/verity.d/"
ok "verity signature covers $roothash, certificate $fingerprint (trusted by the base tree)"

# 4. erofs: compressed, and the extension content.
dump.erofs -s --offset="$root_offset" "$img" >| "$tmp/erofs.txt" 2>&1 || fail "dump.erofs cannot read the root partition"
compr="$(sed -n 's/^Filesystem compr_algs:[[:space:]]*//p' "$tmp/erofs.txt")"
[[ -n "$compr" ]] || fail "root erofs is not compressed (SYSTEMD_REPART_MKFS_OPTIONS_EROFS not applied?)"
ext="$tmp/ext"
mkdir -p "$ext"
fsck.erofs --extract="$ext" --no-preserve-owner --offset="$root_offset" "$img" >/dev/null 2>&1 || fail "fsck.erofs cannot extract the root partition"
top="$(ls -A "$ext" | sort | tr '\n' ' ')"
[[ "$top" == "opt usr " || "$top" == "usr " ]] || fail "sysext top level must be usr (and an empty opt), got: $top"
[[ ! -d "$ext/opt" || -z "$(ls -A "$ext/opt")" ]] || fail "/opt is not empty: CNI DaemonSets need a writable /opt/cni/bin"
[[ ! -e "$ext/usr/lib/os-release" ]] || fail "sysext ships /usr/lib/os-release (would override the host's)"
ok "content: only /usr (no /etc, /var, /opt content, no os-release), erofs compressed with $compr"

# 5. extension-release: exactly one file, named after the image, matching the
#    base os-release the way systemd-sysext(8) matches it.
releases=("$ext"/usr/lib/extension-release.d/extension-release.*)
[[ ${#releases[@]} -eq 1 && "$(basename "${releases[0]}")" == "extension-release.$name" ]] \
        || fail "expected exactly usr/lib/extension-release.d/extension-release.$name, got: ${releases[*]##*/}"
python3 - "${releases[0]}" "$base/usr/lib/os-release" "$version" <<'EOF'
import shlex, sys
def env(path):
    out = {}
    for line in open(path):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            out[k] = shlex.split(v)[0] if v else ""
    return out
ext, base, version = env(sys.argv[1]), env(sys.argv[2]), sys.argv[3]
def check(cond, msg):
    if not cond:
        sys.exit(f"verify-kubernetes: FAIL: extension-release: {msg}")
check(ext.get("ID") == base.get("ID"), f"ID={ext.get('ID')} does not match base ID={base.get('ID')}")
if "SYSEXT_LEVEL" in base:
    check(ext.get("SYSEXT_LEVEL") == base["SYSEXT_LEVEL"], f"SYSEXT_LEVEL={ext.get('SYSEXT_LEVEL')} != base {base['SYSEXT_LEVEL']}")
elif "VERSION_ID" in base:
    check(ext.get("VERSION_ID") == base["VERSION_ID"], f"VERSION_ID={ext.get('VERSION_ID')} != base {base['VERSION_ID']}")
else:
    check("SYSEXT_LEVEL" not in ext and "VERSION_ID" not in ext, "base has neither SYSEXT_LEVEL nor VERSION_ID (rolling release), the extension must not pin one")
check(ext.get("ARCHITECTURE") == "x86-64", f"ARCHITECTURE={ext.get('ARCHITECTURE')}")
check("system" in ext.get("SYSEXT_SCOPE", "system portable").split(), f"SYSEXT_SCOPE={ext.get('SYSEXT_SCOPE')} excludes system")
check(ext.get("SYSEXT_ID") == "kubernetes", f"SYSEXT_ID={ext.get('SYSEXT_ID')}")
check(ext.get("SYSEXT_VERSION_ID") == version, f"SYSEXT_VERSION_ID={ext.get('SYSEXT_VERSION_ID')} != {version}")
check(ext.get("EXTENSION_RELOAD_MANAGER") == "1", "EXTENSION_RELOAD_MANAGER=1 missing (units would not be seen after the merge)")
print("verify-kubernetes: ok: extension-release: " + " ".join(f"{k}={v}" for k, v in ext.items()))
EOF

# 6. Binaries and their versions (x86-64 host: run them from the extracted tree).
#    The extension is an overlay delta: a package the base tree already has
#    (iptables) leaves no trace in it, so the preflight tools may come from
#    either layer.
for b in kubeadm kubelet kubectl containerd containerd-shim-runc-v2 runc crictl; do
        [[ -f "$ext/usr/bin/$b" || -L "$ext/usr/bin/$b" ]] || fail "/usr/bin/$b missing from the extension"
done
for b in conntrack socat ethtool iptables; do
        [[ -e "$ext/usr/bin/$b" || -e "$base/usr/bin/$b" ]] || fail "/usr/bin/$b neither in the extension nor in the base tree"
done
chmod u+x "$ext/usr/bin/kubeadm" "$ext/usr/bin/kubelet"
[[ "$("$ext/usr/bin/kubeadm" version -o short)" == "v$version" ]] || fail "kubeadm reports $("$ext/usr/bin/kubeadm" version -o short), image says $version"
[[ "$("$ext/usr/bin/kubelet" --version)" == "Kubernetes v$version" ]] || fail "kubelet reports $("$ext/usr/bin/kubelet" --version)"
[[ -x "$ext/usr/lib/cni/bridge" ]] || fail "/usr/lib/cni/bridge missing"
ok "kubeadm/kubelet v$version, kubectl, containerd, runc, crictl, CNI plugins in /usr/lib/cni, preflight tools"

# 7. Units, drop-ins and configuration shipped by the extension.
for f in usr/lib/systemd/system/kubelet.service usr/lib/systemd/system/containerd.service \
         usr/lib/systemd/system/kubelet.service.d/10-kubeadm.conf usr/lib/systemd/system/kubelet.service.d/20-vm-manager.conf \
         usr/lib/systemd/system/containerd.service.d/10-vm-manager.conf usr/lib/systemd/system/multi-user.target.d/10-kubernetes.conf \
         usr/lib/systemd/system-preset/50-kubernetes.preset usr/lib/vm-manager/containerd.toml \
         usr/lib/sysctl.d/90-kubernetes.conf usr/lib/sysctl.d/50-kubelet.conf usr/lib/modules-load.d/kubelet.conf usr/lib/tmpfiles.d/kubernetes.conf; do
        [[ -s "$ext/$f" ]] || fail "$f missing"
done
python3 -c 'import sys, tomllib; c = tomllib.load(open(sys.argv[1], "rb")); r = c["plugins"]["io.containerd.cri.v1.runtime"]
assert r["containerd"]["runtimes"]["runc"]["options"]["SystemdCgroup"] is True, "SystemdCgroup"
assert r["cni"]["bin_dirs"][:2] == ["/opt/cni/bin", "/usr/lib/cni"], r["cni"]["bin_dirs"]' "$ext/usr/lib/vm-manager/containerd.toml" \
        || fail "containerd.toml does not parse or lacks SystemdCgroup/bin_dirs"
/usr/bin/grep -q 'containerd.toml' "$ext/usr/lib/systemd/system/containerd.service.d/10-vm-manager.conf" || fail "containerd drop-in does not point at containerd.toml"
/usr/bin/grep -q '^Upholds=containerd.service kubelet.service' "$ext/usr/lib/systemd/system/multi-user.target.d/10-kubernetes.conf" || fail "multi-user.target drop-in lacks Upholds="
for u in systemd-modules-load.service systemd-sysctl.service; do
        /usr/bin/grep -qx 'After=systemd-sysext.service' "$base/usr/lib/systemd/system/$u.d/vm-manager.conf" 2>/dev/null || fail "base tree does not order $u after systemd-sysext.service"
done
ok "units: kubelet + containerd with vm-manager drop-ins, Upholds= from multi-user.target, containerd.toml (SystemdCgroup, CNI dirs), base orders modules-load/sysctl after sysext"

# 8. Merge onto the base tree with systemd-sysext, in an unprivileged user
#    namespace (private mount namespace: nothing on the host or in build/
#    changes). The extension is offered as a directory; that exercises the
#    extension-release matching against the base os-release and the unit
#    files as systemd will see them, but not the DDI/verity path (step 1-3).
if unshare -Urm --propagation=shared true 2>/dev/null; then
        mkdir -p "$tmp/root"
        unshare -Urm --propagation=shared bash -c '
                set -euo pipefail
                root="$1" base="$2" ext="$3" name="$4"
                mount -t tmpfs tmpfs /run
                mount --bind -o ro "$base" "$root"
                mount -t tmpfs tmpfs "$root/var"
                mkdir -p "$root/var/lib/extensions/$name"
                mount --bind -o ro "$ext" "$root/var/lib/extensions/$name"
                systemd-sysext --root="$root" --no-reload merge
                systemd-sysext --root="$root" status --no-legend
                test -x "$root/usr/bin/kubeadm"
                test -s "$root/usr/lib/systemd/system/kubelet.service.d/20-vm-manager.conf"
                test -s "$root/usr/lib/systemd/system/systemd-networkd.service"
                systemd-analyze --root="$root" verify containerd.service kubelet.service multi-user.target
        ' -- "$tmp/root" "$base" "$ext" "$name" >| "$tmp/merge.txt" 2>&1 || fail "merge onto the base tree failed: $(tail -3 "$tmp/merge.txt" | tr '\n' ' ')"
        ok "systemd-sysext merged $name onto the base tree ($(/usr/bin/grep -m1 '^/usr' "$tmp/merge.txt" | tr -s ' ')); systemd-analyze verify is clean"
else
        echo "verify-kubernetes: skip: unprivileged user namespaces unavailable, merge test not run"
fi

# 9. sysupdate: the base image's transfer matches the published file name.
python3 - "$transfer" "$version" "$sysupdate" <<'EOF'
import configparser, os, sys
transfer, version, sysupdate = sys.argv[1:]
c = configparser.ConfigParser(strict=False, interpolation=None)
c.read(transfer)
src, tgt = c["Source"], c["Target"]
fname = src["MatchPattern"].replace("@v", version)
if not os.path.isfile(os.path.join(sysupdate, fname)):
    sys.exit(f"verify-kubernetes: FAIL: transfer expects {fname} in {sysupdate}, found {os.listdir(sysupdate)}")
if not src["Path"].rstrip("/").endswith("/sysupdate/" + os.path.basename(sysupdate)):
    sys.exit(f"verify-kubernetes: FAIL: transfer Source Path={src['Path']} is not the {os.path.basename(sysupdate)} component")
if c["Transfer"].get("Verify", "yes") != "yes":
    sys.exit("verify-kubernetes: FAIL: transfer has Verify=no")
if tgt["Path"] != "/var/lib/extensions":
    sys.exit(f"verify-kubernetes: FAIL: transfer Target Path={tgt['Path']}, systemd-sysext looks in /var/lib/extensions")
print(f"verify-kubernetes: ok: transfer {os.path.basename(transfer)}: {src['Path']}{fname} -> {tgt['Path']}/{tgt['MatchPattern'].replace('@v', version)} (Verify=yes)")
EOF
# gpg rewrites a --keyring file it opens (see scripts/verify); use a copy.
pubring="$(mktemp)"
cp "$keys/import-pubring.pgp" "$pubring"
GNUPGHOME="$keys/gnupg" gpg --batch --quiet --no-default-keyring --keyring "$pubring" \
        --verify "$sysupdate/SHA256SUMS.gpg" "$sysupdate/SHA256SUMS" 2>/dev/null || fail "SHA256SUMS.gpg does not verify"
rm -f "$pubring" "$pubring~"
(cd "$sysupdate" && sha256sum --quiet -c SHA256SUMS) || fail "SHA256SUMS mismatch"
ok "sysupdate/kubernetes: SHA256SUMS.gpg verifies, $(/usr/bin/grep -c . "$sysupdate/SHA256SUMS") artifact(s)"

# 10. Expected PCR 13 of a guest running this version, into policy.json as
#     pcr13.<version> (next to the pcr11 values scripts/verify writes; other
#     versions and the golden values are kept). The rule, mirrored by
#     attest.SysextPCR: PCR 13 starts at zero; the initrd's
#     systemd-pcrosseparator.service extends it with the word "os-separator";
#     vm-kubernetes.service extends it once with the SHA256SUMS line of the
#     merged file, "<sha256>  kubernetes_<version>.raw" (no newline), through
#     systemd-pcrextend. Each extension is PCR := sha256(PCR || sha256(word)).
line="$(/usr/bin/grep -E "  $name\.raw\$" "$sysupdate/SHA256SUMS")"
[[ -n "$line" ]] || fail "SHA256SUMS has no line for $name.raw"
python3 - "$build/policy.json" "$version" "$line" <<'EOF'
import hashlib, json, sys
policy, version, line = sys.argv[1:]
pcr = bytes(32)
for word in ("os-separator", line):
    pcr = hashlib.sha256(pcr + hashlib.sha256(word.encode()).digest()).digest()
try:
    out = json.load(open(policy))
except (OSError, ValueError):
    out = {}
out.setdefault("pcr13", {})[version] = pcr.hex()
json.dump(out, open(policy, "w"), indent=2)
open(policy, "a").write("\n")
print(f"verify-kubernetes: ok: pcr13[{version}] = {pcr.hex()} (os-separator, then '{line}') written to {policy}")
EOF

echo "verify-kubernetes: $name.raw $(du -h "$img" | cut -f1) ($(du -sh "$ext" | cut -f1) uncompressed), roothash $roothash"
echo "verify-kubernetes: PASS"
