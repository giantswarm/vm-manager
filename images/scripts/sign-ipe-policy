#!/usr/bin/env bash
# Sign the IPE policy for the base image:
#
#   sign-ipe-policy <policy> <version> <keys> <tree>
#
# writes <tree>/etc/ipe/giantswarm-vm.p7b, which ExtraTrees= of
# mkosi.images/base/mkosi.conf copies into the root file system. The policy's
# @VERSION@ becomes the image version (IPE wants major.minor.rev). The
# signature is the inline PKCS#7 the kernel's securityfs interface expects
# (Documentation/admin-guide/LSM/ipe.rst), made with the verity key: the
# kernel checks it against the platform keyring, where vm-manager's UEFI db
# enrollment of keys/verity.crt puts the certificate. systemd names the
# policy after the file, so the file stem is the policy_name.
set -euo pipefail

policy="${1:?usage: sign-ipe-policy <policy> <version> <keys> <tree>}" version="${2:?version}" keys="${3:?keys dir}" tree="${4:?tree dir}"

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "sign-ipe-policy: version '$version' is not major.minor.rev, which IPE requires" >&2
        exit 1
fi

name="$(sed -n 's/^policy_name=\([^ ]*\) .*/\1/p' "$policy")"
[[ -n "$name" ]] || { echo "sign-ipe-policy: no policy_name= header in $policy" >&2; exit 1; }

out="$tree/etc/ipe/$name.p7b"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
sed "s/@VERSION@/$version/" "$policy" >| "$tmp"

mkdir -p "$(dirname "$out")"
openssl smime -sign -in "$tmp" -signer "$keys/verity.crt" -inkey "$keys/verity.key" \
        -noattr -nodetach -nosmimecap -binary -outform der -out "$out"
# The kernel parses exactly what was signed: prove the content round-trips.
openssl smime -verify -noverify -inform der -in "$out" -binary 2>/dev/null | cmp -s - "$tmp" ||
        { echo "sign-ipe-policy: $out does not carry the policy verbatim" >&2; exit 1; }
echo "sign-ipe-policy: $out (policy $name, version $version)"
