#!/usr/bin/env bash
# Offline verification of the published sysexts of one component, kubernetes
# or cni. No root, no boot:
# each DDI is read with sfdisk and systemd-dissect --validate, the erofs is
# extracted with fsck.erofs, and the extension is merged onto the base tree
# with systemd-sysext in an unprivileged user namespace (directory form of the
# extension; loop devices for the DDI itself need root).
#
#   verify-sysext kubernetes|cni <build> <keys> [version...]
#
# Without versions, every <component>_<v>.raw listed in
# build/sysupdate/<component>/SHA256SUMS is verified. The directory is checked
# as a whole first (signature, sums, the transfer's MatchPattern names every
# file), then each version (steps 1-8, 6-8 per component), and the sha256 of
# each version's file is written to build/policy.json
# (sysexts.<component>.<version>, step 9), from which vm-manager computes the
# PCR 13 of every Kubernetes x CNI combination; entries of versions no longer
# published are dropped.
set -euo pipefail

component="${1:?component (kubernetes|cni)}" build="${2:?build dir}" keys="${3:?keys dir}"
shift 3
case "$component" in
kubernetes) version_var=KUBERNETES_VERSION ;;
cni) version_var=CNI_VERSION ;;
*) echo "verify-sysext: unknown component $component" >&2; exit 1 ;;
esac
base="$build/base"
sysupdate="$build/sysupdate/$component"
transfer="$base/usr/lib/sysupdate.$component.d/50-$component.transfer"
policy="$build/policy.json"

tmp="$(mktemp -d)"
trap 'chmod -R u+rwX "$tmp" 2>/dev/null; rm -rf "$tmp"' EXIT
fail() { echo "verify-sysext $component: FAIL: $*" >&2; exit 1; }
ok() { echo "verify-sysext $component: ok: $*"; }

for f in "$base/usr/lib/os-release" "$transfer" "$sysupdate/SHA256SUMS" "$sysupdate/SHA256SUMS.gpg"; do
        [[ -s "$f" ]] || fail "$f missing (run make base $component)"
done
mapfile -t published < <(sed -n "s/^[0-9a-f]\{64\}  ${component}_\(.*\)\.raw\$/\1/p" "$sysupdate/SHA256SUMS" | sort -V)
[[ ${#published[@]} -gt 0 ]] || fail "$sysupdate/SHA256SUMS lists no ${component}_<v>.raw (run make $component)"
versions=("$@")
[[ ${#versions[@]} -gt 0 ]] || versions=("${published[@]}")
fingerprint="$(openssl x509 -in "$keys/verity.crt" -noout -fingerprint -sha256 | sed 's/.*=//; s/://g' | tr 'A-F' 'a-f')"

# A. The component directory: SHA256SUMS.gpg verifies with the key the guest
#    trusts, every file is listed with the right sum, nothing is listed that
#    is not there, and the base image's transfer matches every published
#    version (and nothing else in the directory).
# gpg rewrites a --keyring file it opens (see scripts/verify); use a copy.
pubring="$(mktemp)"
cp "$keys/import-pubring.pgp" "$pubring"
GNUPGHOME="$keys/gnupg" gpg --batch --quiet --no-default-keyring --keyring "$pubring" \
        --verify "$sysupdate/SHA256SUMS.gpg" "$sysupdate/SHA256SUMS" 2>/dev/null || fail "SHA256SUMS.gpg does not verify"
rm -f "$pubring" "$pubring~"
(cd "$sysupdate" && sha256sum --quiet -c SHA256SUMS) || fail "SHA256SUMS mismatch"
unlisted="$(cd "$sysupdate" && find . -maxdepth 1 -type f ! -name 'SHA256SUMS*' -printf '%f\n' | sort | comm -23 - <(cut -c67- SHA256SUMS | sort))"
[[ -z "$unlisted" ]] || fail "not in SHA256SUMS: $unlisted (republish with make $component)"
ok "sysupdate/$component: SHA256SUMS.gpg verifies, $(/usr/bin/grep -c . "$sysupdate/SHA256SUMS") file(s), versions ${published[*]}"

python3 - "$transfer" "$sysupdate" "${published[@]}" <<'EOF'
import configparser, os, re, sys
transfer, sysupdate, *versions = sys.argv[1:]
c = configparser.ConfigParser(strict=False, interpolation=None)
c.read(transfer)
src, tgt = c["Source"], c["Target"]
def fail(msg):
    sys.exit(f"verify-sysext: FAIL: transfer {os.path.basename(transfer)}: {msg}")
if "@v" not in src["MatchPattern"] or "@v" not in tgt["MatchPattern"]:
    fail("MatchPattern must carry @v, the version vm-kubernetes.service asks for")
if not src["Path"].rstrip("/").endswith("/sysupdate/" + os.path.basename(sysupdate)):
    fail(f"Source Path={src['Path']} is not the {os.path.basename(sysupdate)} component")
if c["Transfer"].get("Verify", "yes") != "yes":
    fail("Verify=no")
if tgt["Path"] != "/var/lib/extensions":
    fail(f"Target Path={tgt['Path']}, systemd-sysext looks in /var/lib/extensions")
instances = int(tgt.get("InstancesMax", "2"))
if instances < 2:
    fail(f"InstancesMax={instances}, sysupdate.d(5) rejects less than 2")
regex = re.compile("^" + re.escape(src["MatchPattern"]).replace(re.escape("@v"), "(?P<v>[^/]+)") + "$")
for v in versions:
    if not os.path.isfile(os.path.join(sysupdate, src["MatchPattern"].replace("@v", v))):
        fail(f"expects {src['MatchPattern'].replace('@v', v)} for {v} in {sysupdate}, found {sorted(os.listdir(sysupdate))}")
for f in sorted(os.listdir(sysupdate)):
    if f.startswith("SHA256SUMS"):
        continue
    m = regex.match(f)
    if not m:
        fail(f"{f} in {sysupdate} does not match Source MatchPattern={src['MatchPattern']}")
    if m.group("v") not in versions:
        fail(f"{f} is not in SHA256SUMS")
print(f"verify-sysext: ok: transfer {os.path.basename(transfer)}: {src['Path']}{src['MatchPattern']} -> {tgt['Path']}/{tgt['MatchPattern']} matches {', '.join(versions)} (Verify=yes, InstancesMax={instances})")
EOF

# Steps 6-8 per component: binaries, configuration and the merge onto the
# base tree. Arguments: version, name, extracted tree.
content_kubernetes() {
        local version="$1" name="$2" ext="$3"
        # 6. Binaries and their versions (x86-64 host: run them from the extracted tree).
        #    The extension is an overlay delta: a package the base tree already has
        #    (iptables) leaves no trace in it, so the preflight tools may come from
        #    either layer.
        for b in kubeadm kubelet kubectl containerd containerd-shim-runc-v2 runc crictl; do
                [[ -f "$ext/usr/bin/$b" || -L "$ext/usr/bin/$b" ]] || fail "/usr/bin/$b missing from the extension"
        done
        for b in conntrack socat ethtool iptables; do
                [[ -e "$ext/usr/bin/$b" || -e "$base/usr/bin/$b" ]] || fail "/usr/bin/$b neither in the extension nor in the base tree"
        done
        chmod u+x "$ext/usr/bin/kubeadm" "$ext/usr/bin/kubelet" "$ext/usr/bin/kubectl" "$ext/usr/bin/containerd" "$ext/usr/bin/runc" "$ext/usr/bin/crictl"
        [[ "$("$ext/usr/bin/kubeadm" version -o short)" == "v$version" ]] || fail "kubeadm reports $("$ext/usr/bin/kubeadm" version -o short), image says $version"
        [[ "$("$ext/usr/bin/kubelet" --version)" == "Kubernetes v$version" ]] || fail "kubelet reports $("$ext/usr/bin/kubelet" --version)"
        [[ "$("$ext/usr/bin/kubectl" version --client -o json | python3 -c 'import json, sys; print(json.load(sys.stdin)["clientVersion"]["gitVersion"])')" == "v$version" ]] \
                || fail "kubectl reports $("$ext/usr/bin/kubectl" version --client 2>&1 | head -1), image says $version"
        [[ -x "$ext/usr/lib/cni/bridge" ]] || fail "/usr/lib/cni/bridge missing"
        # containerd prints "containerd github.com/containerd/containerd/v2 v2.4.2-gs.4 <commit>";
        # Arch builds crictl without its version string.
        ok "kubeadm/kubelet/kubectl v$version; containerd $("$ext/usr/bin/containerd" --version | /usr/bin/grep -oE ' v[0-9][^ ]*' | head -1 | tr -d ' '), $("$ext/usr/bin/runc" --version | head -1), CNI plugins in /usr/lib/cni, crictl, preflight tools"

        # 7. Units, drop-ins and configuration shipped by the extension.
        for f in usr/lib/systemd/system/kubelet.service usr/lib/systemd/system/containerd.service \
                 usr/lib/systemd/system/kubelet.service.d/10-kubeadm.conf usr/lib/systemd/system/kubelet.service.d/20-vm-manager.conf \
                 usr/lib/systemd/system/containerd.service.d/10-vm-manager.conf usr/lib/systemd/system/multi-user.target.d/10-kubernetes.conf \
                 usr/lib/systemd/system-preset/50-kubernetes.preset usr/lib/vm-manager/containerd.toml \
                 usr/lib/sysctl.d/90-kubernetes.conf usr/lib/sysctl.d/50-kubelet.conf usr/lib/modules-load.d/kubelet.conf usr/lib/modules-load.d/containerd.conf usr/lib/tmpfiles.d/kubernetes.conf; do
                [[ -s "$ext/$f" ]] || fail "$f missing"
        done
        python3 -c 'import sys, tomllib; c = tomllib.load(open(sys.argv[1], "rb")); r = c["plugins"]["io.containerd.cri.v1.runtime"]
assert r["containerd"]["runtimes"]["runc"]["options"]["SystemdCgroup"] is True, "SystemdCgroup"
assert r["cni"]["bin_dirs"] == ["/usr/lib/cni"], r["cni"]["bin_dirs"]
p = c["plugins"]
assert p["io.containerd.cri.v1.images"]["snapshotter"] == "erofs", "CRI snapshotter"
d = p["io.containerd.differ.v1.erofs"]
assert d["enable_tar_index"] is True and d["enable_dmverity"] is True and d["enable_dmverity_referrers"] is True, d
s = p["io.containerd.snapshotter.v1.erofs"]
assert s["dmverity_mode"] == "on" and s["enable_dmverity_referrers"] is True, s
u = p["io.containerd.transfer.v1.local"]["unpack_config"]
assert [(x["platform"], x["snapshotter"], x["differ"]) for x in u] == [("linux/amd64", "erofs", "erofs")], u' "$ext/usr/lib/vm-manager/containerd.toml" \
                || fail "containerd.toml does not parse or lacks SystemdCgroup/bin_dirs/signed EROFS layers"
        /usr/bin/grep -q 'containerd.toml' "$ext/usr/lib/systemd/system/containerd.service.d/10-vm-manager.conf" || fail "containerd drop-in does not point at containerd.toml"
        /usr/bin/grep -q '^Upholds=containerd.service kubelet.service' "$ext/usr/lib/systemd/system/multi-user.target.d/10-kubernetes.conf" || fail "multi-user.target drop-in lacks Upholds="
        for u in systemd-modules-load.service systemd-sysctl.service; do
                /usr/bin/grep -qx 'After=systemd-sysext.service' "$base/usr/lib/systemd/system/$u.d/vm-manager.conf" 2>/dev/null || fail "base tree does not order $u after systemd-sysext.service"
        done
        ok "units: kubelet + containerd with vm-manager drop-ins, Upholds= from multi-user.target, containerd.toml (SystemdCgroup, bin_dirs only /usr/lib/cni, EROFS with signed dm-verity layers), base orders modules-load/sysctl after sysext"

        # 8. Merge onto the base tree with systemd-sysext, in an unprivileged user
        #    namespace (private mount namespace: nothing on the host or in build/
        #    changes). The extension is offered as a directory; that exercises the
        #    extension-release matching against the base os-release and the unit
        #    files as systemd will see them, but not the DDI/verity path (step 1-3).
        if unshare -Urm --propagation=shared true 2>/dev/null; then
                mkdir -p "$tmp/root"
                unshare -Urm --propagation=shared bash -c '
                        set -euo pipefail
                        root="$1" base="$2" ext="$3" name="$4"
                        mount -t tmpfs tmpfs /run
                        mount --bind -o ro "$base" "$root"
                        mount -t tmpfs tmpfs "$root/var"
                        mkdir -p "$root/var/lib/extensions/$name"
                        mount --bind -o ro "$ext" "$root/var/lib/extensions/$name"
                        systemd-sysext --root="$root" --no-reload merge
                        systemd-sysext --root="$root" status --no-legend
                        test -x "$root/usr/bin/kubeadm"
                        test -s "$root/usr/lib/systemd/system/kubelet.service.d/20-vm-manager.conf"
                        test -s "$root/usr/lib/systemd/system/systemd-networkd.service"
                        # --man=no: the check is the unit graph, not whether
                        # the host has man(1) for the Documentation= pages
                        # (CI containers do not).
                        systemd-analyze --root="$root" --man=no verify containerd.service kubelet.service multi-user.target
                ' -- "$tmp/root" "$base" "$ext" "$name" >| "$tmp/merge.txt" 2>&1 || fail "merge onto the base tree failed: $(tail -3 "$tmp/merge.txt" | tr '\n' ' ')"
                ok "systemd-sysext merged $name onto the base tree ($(/usr/bin/grep -m1 '^/usr' "$tmp/merge.txt" | tr -s ' ')); systemd-analyze verify is clean"
        else
                echo "verify-sysext $component: skip: unprivileged user namespaces unavailable, merge test not run"
        fi
}

content_cni() {
        local version="$1" name="$2" ext="$3" plugin found=()
        # 6. Plugins: what the entry stages, x86-64 executables in /usr/lib/cni,
        #    the one directory containerd's bin_dirs lists; besides them only
        #    sysctl drop-ins (cni.extra/<name>), nothing else.
        for plugin in "$ext"/usr/lib/cni/*; do
                file -b "$plugin" | /usr/bin/grep -q '^ELF 64-bit LSB .*x86-64' || fail "${plugin#"$ext"} is not an x86-64 ELF executable"
                found+=("${plugin##*/}")
        done
        [[ ${#found[@]} -gt 0 ]] || fail "no plugins in /usr/lib/cni"
        local other
        other="$(cd "$ext/usr" && find . -type f ! -path './lib/cni/*' ! -path './lib/extension-release.d/*' ! -path './lib/sysctl.d/*.conf' -printf '%P ')"
        [[ -z "$other" ]] || fail "files outside /usr/lib/cni and /usr/lib/sysctl.d: $other"
        ok "plugins in /usr/lib/cni: ${found[*]}; sysctl drop-ins: $(cd "$ext/usr" && find lib/sysctl.d -type f -printf '%f ' 2>/dev/null)"

        # 7. The plugins of the entry the version names (cni/<name>).
        local entry release="" plugins_spec="" p
        entry="$(dirname "$0")/../cni/${version%%-*}"
        if [[ -f "$entry" ]]; then
                # shellcheck source=/dev/null
                release="$(. "$entry" && echo "$release")" plugins_spec="$(. "$entry" && echo "$plugins")"
                if [[ "${version%%-*}-${release#v}" == "$version" ]]; then
                        for p in $plugins_spec; do
                                p="${p##*:}"
                                [[ -x "$ext/usr/lib/cni/${p##*/}" ]] || fail "cni/${version%%-*} names plugin ${p##*/}, the extension lacks it"
                        done
                        ok "entry cni/${version%%-*} ($release): every plugin present"
                        local extra f
                        extra="$(dirname "$0")/../cni.extra/${version%%-*}"
                        if [[ -d "$extra" ]]; then
                                while IFS= read -r f; do
                                        cmp -s "$extra/$f" "$ext/$f" || fail "cni.extra/${version%%-*}/$f is missing from the extension or differs"
                                done < <(cd "$extra" && find . -type f -printf '%P\n')
                                ok "cni.extra/${version%%-*}: every file present and identical"
                        fi
                else
                        echo "verify-sysext $component: skip: cni/${version%%-*} pins ${release}, $version is an earlier release"
                fi
        fi

        # 8. Merge onto the base tree, as for kubernetes: the plugins appear
        #    executable under /usr/lib/cni of the merged root.
        if unshare -Urm --propagation=shared true 2>/dev/null; then
                mkdir -p "$tmp/root"
                unshare -Urm --propagation=shared bash -c '
                        set -euo pipefail
                        root="$1" base="$2" ext="$3" name="$4"
                        shift 4
                        mount -t tmpfs tmpfs /run
                        mount --bind -o ro "$base" "$root"
                        mount -t tmpfs tmpfs "$root/var"
                        mkdir -p "$root/var/lib/extensions/$name"
                        mount --bind -o ro "$ext" "$root/var/lib/extensions/$name"
                        systemd-sysext --root="$root" --no-reload merge
                        systemd-sysext --root="$root" status --no-legend
                        for p; do test -x "$root/usr/lib/cni/$p"; done
                ' -- "$tmp/root" "$base" "$ext" "$name" "${found[@]}" >| "$tmp/merge.txt" 2>&1 || fail "merge onto the base tree failed: $(tail -3 "$tmp/merge.txt" | tr '\n' ' ')"
                ok "systemd-sysext merged $name onto the base tree ($(/usr/bin/grep -m1 '^/usr' "$tmp/merge.txt" | tr -s ' '))"
        else
                echo "verify-sysext $component: skip: unprivileged user namespaces unavailable, merge test not run"
        fi
}

# B. One version: the DDI, its signature, content, units, the merge, PCR 13.
verify_version() {
        local version="$1" name="${component}_$1" img="$build/${component}_$1.raw" ext="$tmp/ext-$1" roothash compr top releases line
        for f in "$img" "$build/$name.roothash" "$sysupdate/$name.raw"; do
                [[ -s "$f" ]] || fail "$f missing (run make $component $version_var=$version)"
        done
        cmp -s "$img" "$sysupdate/$name.raw" || fail "$sysupdate/$name.raw is not the built $img (republish with make $component $version_var=$version)"
        roothash="$(tr -d '\n' <"$build/$name.roothash")"
        [[ ${#roothash} -eq 64 ]] || fail "roothash $roothash is not a sha256"
        echo "verify-sysext $component: --- $name"

        # 1. Partition table: root, verity, signature and nothing else (a sysext DDI
        #    has no ESP); root/verity UUIDs derived from the root hash as for the disk.
        sfdisk --json "$img" >| "$tmp/sfdisk.json"
        eval "$(python3 - "$tmp/sfdisk.json" "$roothash" <<'EOF'
import json, sys
types = {
    "4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709": "root",
    "2C7357ED-EBD2-46D9-AEC1-23D437EC2BF5": "verity",
    "41092B05-9FC8-4523-994F-2DEF0408B176": "sig",
}
table = json.load(open(sys.argv[1]))["partitiontable"]
sector = table.get("sectorsize", 512)
parts = {}
for p in table["partitions"]:
    d = types.get(p["type"].upper())
    if not d:
        sys.exit(f"verify-sysext: FAIL: unexpected partition type {p['type']} in sysext")
    parts[d] = p
missing = [d for d in types.values() if d not in parts]
if missing:
    sys.exit(f"verify-sysext: FAIL: sysext lacks {missing} partition")
roothash = sys.argv[2]
hexuuid = lambda p: p["uuid"].replace("-", "").lower()
if hexuuid(parts["root"]) != roothash[:32] or hexuuid(parts["verity"]) != roothash[32:]:
    sys.exit("verify-sysext: FAIL: root/verity partition UUIDs are not derived from the roothash")
for d, p in parts.items():
    print(f"{d}_offset={p['start'] * sector} {d}_size={p['size'] * sector}")
EOF
)"
        ok "partitions root/verity/sig only, root/verity UUIDs match roothash halves"

        # 2. systemd-dissect accepts it under a policy that demands signed verity for
        #    root and no /usr partition (the default sysext policy is more permissive).
        systemd-dissect --validate --image-policy=root=signed:usr=absent "$img" >/dev/null || fail "systemd-dissect --validate rejects $img"
        ok "systemd-dissect --validate (root=signed:usr=absent)"

        # 3. Signature partition: the JSON root hash is ours and the signing
        #    certificate is the verity certificate of this key set (what the base image
        #    trusts in /usr/lib/verity.d/).
        dd if="$img" bs=512 skip=$((sig_offset / 512)) count=$((sig_size / 512)) status=none | tr -d '\000' >| "$tmp/sig.json"
        python3 - "$tmp/sig.json" "$roothash" "$fingerprint" <<'EOF'
import json, sys
sig = json.load(open(sys.argv[1]))
if sig["rootHash"] != sys.argv[2]:
    sys.exit(f"verify-sysext: FAIL: signature is for root hash {sig['rootHash']}, image has {sys.argv[2]}")
if sig["certificateFingerprint"].lower() != sys.argv[3]:
    sys.exit(f"verify-sysext: FAIL: signed with certificate {sig['certificateFingerprint']}, keys/verity.crt is {sys.argv[3]}")
EOF
        [[ -s "$base/usr/lib/verity.d/verity.crt" ]] && cmp -s "$base/usr/lib/verity.d/verity.crt" "$keys/verity.crt" \
                || fail "base tree does not trust $keys/verity.crt in /usr/lib/verity.d/"
        ok "verity signature covers $roothash, certificate $fingerprint (trusted by the base tree)"

        # 4. erofs: compressed, and the extension content.
        dump.erofs -s --offset="$root_offset" "$img" >| "$tmp/erofs.txt" 2>&1 || fail "dump.erofs cannot read the root partition"
        compr="$(sed -n 's/^Filesystem compr_algs:[[:space:]]*//p' "$tmp/erofs.txt")"
        [[ -n "$compr" ]] || fail "root erofs is not compressed (SYSTEMD_REPART_MKFS_OPTIONS_EROFS not applied?)"
        mkdir -p "$ext"
        fsck.erofs --extract="$ext" --no-preserve-owner --offset="$root_offset" "$img" >/dev/null 2>&1 || fail "fsck.erofs cannot extract the root partition"
        top="$(ls -A "$ext" | sort | tr '\n' ' ')"
        [[ "$top" == "opt usr " || "$top" == "usr " ]] || fail "sysext top level must be usr (and an empty opt), got: $top"
        [[ ! -d "$ext/opt" || -z "$(ls -A "$ext/opt")" ]] || fail "/opt is not empty: an extension's /opt is read-only, and CNI DaemonSets still copy their plugins into /opt/cni/bin (unused, but the copy must succeed)"
        [[ ! -e "$ext/usr/lib/os-release" ]] || fail "sysext ships /usr/lib/os-release (would override the host's)"
        ok "content: only /usr (no /etc, /var, /opt content, no os-release), erofs compressed with $compr"

        # 5. extension-release: exactly one file, named after the image, matching the
        #    base os-release the way systemd-sysext(8) matches it.
        releases=("$ext"/usr/lib/extension-release.d/extension-release.*)
        [[ ${#releases[@]} -eq 1 && "$(basename "${releases[0]}")" == "extension-release.$name" ]] \
                || fail "expected exactly usr/lib/extension-release.d/extension-release.$name, got: ${releases[*]##*/}"
        python3 - "${releases[0]}" "$base/usr/lib/os-release" "$version" "$component" <<'EOF'
import shlex, sys
def env(path):
    out = {}
    for line in open(path):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            out[k] = shlex.split(v)[0] if v else ""
    return out
ext, base, version, component = env(sys.argv[1]), env(sys.argv[2]), sys.argv[3], sys.argv[4]
def check(cond, msg):
    if not cond:
        sys.exit(f"verify-sysext: FAIL: extension-release: {msg}")
check(ext.get("ID") == base.get("ID"), f"ID={ext.get('ID')} does not match base ID={base.get('ID')}")
if "SYSEXT_LEVEL" in base:
    check(ext.get("SYSEXT_LEVEL") == base["SYSEXT_LEVEL"], f"SYSEXT_LEVEL={ext.get('SYSEXT_LEVEL')} != base {base['SYSEXT_LEVEL']}")
elif "VERSION_ID" in base:
    check(ext.get("VERSION_ID") == base["VERSION_ID"], f"VERSION_ID={ext.get('VERSION_ID')} != base {base['VERSION_ID']}")
else:
    check("SYSEXT_LEVEL" not in ext and "VERSION_ID" not in ext, "base has neither SYSEXT_LEVEL nor VERSION_ID (rolling release), the extension must not pin one")
check(ext.get("ARCHITECTURE") == "x86-64", f"ARCHITECTURE={ext.get('ARCHITECTURE')}")
check("system" in ext.get("SYSEXT_SCOPE", "system portable").split(), f"SYSEXT_SCOPE={ext.get('SYSEXT_SCOPE')} excludes system")
check(ext.get("SYSEXT_ID") == component, f"SYSEXT_ID={ext.get('SYSEXT_ID')}")
check(ext.get("SYSEXT_VERSION_ID") == version, f"SYSEXT_VERSION_ID={ext.get('SYSEXT_VERSION_ID')} != {version}")
if component == "kubernetes":
    check(ext.get("EXTENSION_RELOAD_MANAGER") == "1", "EXTENSION_RELOAD_MANAGER=1 missing (units would not be seen after the merge)")
print("verify-sysext: ok: extension-release: " + " ".join(f"{k}={v}" for k, v in ext.items()))
EOF

        content_"$component" "$version" "$name" "$ext"

        # 9. The sha256 of the published file into policy.json as
        #    sysexts.<component>.<version> (next to the pcr11 values scripts/verify
        #    writes; other entries and the golden values are kept). vm-manager
        #    computes a guest's PCR 13 from them (attest.SysextPCR): PCR 13 starts
        #    at zero; the initrd's systemd-pcrosseparator.service extends it with
        #    the word "os-separator"; vm-kubernetes.service extends it with the
        #    SHA256SUMS line of each merged file, "<sha256>  <component>_<version>.raw"
        #    (no newline), kubernetes first, then cni, through systemd-pcrextend.
        #    Each extension is PCR := sha256(PCR || sha256(word)), so one entry per
        #    sysext covers every Kubernetes x CNI combination.
        line="$(/usr/bin/grep -E "  $name\.raw\$" "$sysupdate/SHA256SUMS")"
        [[ -n "$line" ]] || fail "SHA256SUMS has no line for $name.raw"
        python3 - "$policy" "$component" "$version" "${line%%  *}" <<'EOF'
import json, sys
policy, component, version, sha256 = sys.argv[1:]
try:
    out = json.load(open(policy))
except (OSError, ValueError):
    out = {}
# pcr13 (a value per Kubernetes version) is what images built before
# sysexts carried; sysexts supersedes it.
out.pop("pcr13", None)
out.setdefault("sysexts", {}).setdefault(component, {})[version] = sha256
json.dump(out, open(policy, "w"), indent=2)
open(policy, "a").write("\n")
print(f"verify-sysext {component}: ok: sysexts.{component}[{version}] = {sha256} written to {policy}")
EOF
        echo "verify-sysext $component: $name.raw $(du -h "$img" | cut -f1) ($(du -sh "$ext" | cut -f1) uncompressed), roothash $roothash"
}

for version in "${versions[@]}"; do
        verify_version "$version"
done

# C. policy.json carries sysexts.<component> for exactly the published
#    versions: a version whose file was retired from the directory can no
#    longer be attested.
python3 - "$policy" "$component" "${published[@]}" <<'EOF'
import json, sys
policy, component, *published = sys.argv[1:]
out = json.load(open(policy))
entries = out.get("sysexts", {}).get(component, {})
stale = sorted(v for v in entries if v not in published)
for v in stale:
    del entries[v]
missing = [v for v in published if v not in entries]
if missing:
    sys.exit(f"verify-sysext {component}: FAIL: {policy} lacks sysexts.{component} for published {missing}; run verify-sysext {component} without versions")
if stale:
    json.dump(out, open(policy, "w"), indent=2)
    open(policy, "a").write("\n")
    print(f"verify-sysext {component}: dropped sysexts.{component} of unpublished {', '.join(stale)} from {policy}")
print(f"verify-sysext {component}: ok: {policy} sysexts.{component} covers {', '.join(sorted(entries))}")
EOF

echo "verify-sysext $component: PASS (${versions[*]})"
