policy_name=giantswarm-vm policy_version=@VERSION@
# IPE policy of giantswarm-vm-base, signed at build time with the image's
# verity key (scripts/sign-ipe-policy) and installed as
# /etc/ipe/giantswarm-vm.p7b, which systemd (PID 1) loads and activates right
# after the switch to the real root, before it starts anything there.
#
# The kernel executes, maps executable and loads code only from a dm-verity
# device whose root hash signature it verified itself: the base image's root
# and the Kubernetes sysext (through the /usr overlay, IPE judges the file's
# real inode). Nothing on the var partition, the /etc overlay's upper layer,
# /run, /tmp or anonymous executable memory runs, and no kernel module,
# firmware, kexec image, IMA policy or X.509 certificate comes from there.
# vm-manager enrolls the verity certificate into the VM's UEFI db, which puts
# it on the kernel's platform keyring: that is what makes the signatures
# kernel-verified and this policy loadable. The initrd runs without a policy:
# it is part of the measured UKI and executes nothing it does not carry.
#
# The global default is DENY, so an operation a newer kernel adds is denied
# until this policy allows it.
DEFAULT action=DENY
op=EXECUTE dmverity_signature=TRUE action=ALLOW
op=FIRMWARE dmverity_signature=TRUE action=ALLOW
op=KMODULE dmverity_signature=TRUE action=ALLOW
op=KEXEC_IMAGE dmverity_signature=TRUE action=ALLOW
op=KEXEC_INITRAMFS dmverity_signature=TRUE action=ALLOW
op=POLICY dmverity_signature=TRUE action=ALLOW
op=X509_CERT dmverity_signature=TRUE action=ALLOW
