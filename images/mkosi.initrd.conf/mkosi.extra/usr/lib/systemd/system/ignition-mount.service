# Ported from Ignition's dracut/30ignition/ignition-mount.service: mounts the
# file systems the config declares under /sysroot for the files stage and
# unmounts them (ExecStop=) before the switch root. No remount-sysroot
# service: the writable parts of /sysroot are the mounts persistent-etc.service
# sets up, which is why this stage is ordered after it.
[Unit]
Description=Ignition (mount)
Documentation=https://coreos.github.io/ignition/
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
ConditionKernelCommandLine=ignition.firstboot
Before=ignition-complete.target

After=ignition-disks.service
Before=ignition-files.service

Before=initrd-switch-root.target
After=network.target

Requires=initrd-root-fs.target
After=initrd-root-fs.target persistent-etc.service

OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=mount --log-to-stdout
ExecStop=/usr/bin/ignition --root=/sysroot --platform=metal --stage=umount --log-to-stdout
