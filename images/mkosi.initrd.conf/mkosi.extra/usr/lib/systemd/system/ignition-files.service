# Ported from Ignition's dracut/30ignition/ignition-files.service: writes the
# config's files, systemd units and presets into /sysroot (--root). Ordered
# after the root overlay (systemd-volatile-root.service today, the persistent
# /etc overlay unit once it exists: anything that prepares /sysroot before
# initrd-root-fs.target is covered) and after sysroot-var.mount, so that files
# below /var land on the var partition once the initrd mounts it there. Until
# then a write below /var would go to the overlay's tmpfs upper and make
# systemd-gpt-auto-generator skip the var partition ("already populated").
# Before initrd-parse-etc.service, so what Ignition drops into /sysroot/etc is
# seen when the generators run against the real root.
[Unit]
Description=Ignition (files)
Documentation=https://coreos.github.io/ignition/
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
ConditionKernelCommandLine=ignition.firstboot
Before=ignition-complete.target

After=ignition-mount.service
After=initrd-root-fs.target systemd-volatile-root.service sysroot-var.mount
Before=initrd-parse-etc.service

OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=files --log-to-stdout
