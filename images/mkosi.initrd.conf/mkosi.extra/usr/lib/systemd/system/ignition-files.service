# Ported from Ignition's dracut/30ignition/ignition-files.service: writes the
# config's files, systemd units and presets into /sysroot (--root). Ordered
# after persistent-etc.service, which mounts the var partition on /sysroot/var
# and the persistent overlay on /sysroot/etc, so that files below /var and /etc
# land on the var partition; the rest of the root is the read-only verity
# erofs (EROFS for a config that writes there). Before initrd-parse-etc.service,
# so what Ignition drops into /sysroot/etc is seen when the generators run
# against the real root.
[Unit]
Description=Ignition (files)
Documentation=https://coreos.github.io/ignition/
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
ConditionKernelCommandLine=ignition.firstboot
Before=ignition-complete.target

After=ignition-mount.service
After=initrd-root-fs.target persistent-etc.service
Before=initrd-parse-etc.service

OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=files --log-to-stdout
