#!/usr/bin/env bash
# Pull the Kubernetes and CNI sysexts the VM was created with, activate them
# and measure them into PCR 13. Run once per boot by vm-kubernetes.service.
#
#  1. /kubernetes-version from the IMDS names the Kubernetes version; an unset
#     key means the VM runs without Kubernetes and the unit ends here.
#     /cni-version names the CNI sysext, "<cni>-<release>"; an unset key means
#     the VM runs without one (containerd then has the reference plugins of
#     the Kubernetes sysext only).
#  2. Per component, every other <component>_*.raw in /var/lib/extensions is
#     removed first: systemd-sysext merges every image it finds (the later
#     name wins per file), so exactly one version of each may be present when
#     it refreshes. The sysupdate transfers keep InstancesMax=2 (the minimum
#     sysupdate.d(5) accepts); this is what enforces one.
#  3. systemd-sysupdate --component=<component> update <version> downloads
#     <component>_<version>.raw from the vm-manager IMDS directory, verifying
#     SHA256SUMS.gpg against /etc/systemd/import-pubring.pgp; an already
#     present version is a no-op. It runs from /usr/lib/systemd, like
#     systemd-imds and systemd-pcrextend: systemd 262 no longer installs it in
#     /usr/bin (updatectl is the command there), and images/scripts/verify
#     checks every tool these scripts run is in the image.
#  4. systemd-sysext refresh merges them, once: the image disables
#     systemd-sysupdate-notify-sysext.socket, so no pull triggers a merge of
#     its own (a no-op when systemd-sysext.service already merged these very
#     files early in the boot). What systemd-sysext reports as merged and
#     as present must be exactly these two images, and
#     no extension-release file may name another; anything else fails the unit. The Kubernetes
#     extension carries EXTENSION_RELOAD_MANAGER=1, so the refresh reloads the
#     manager and the Upholds= of multi-user.target starts containerd and
#     kubelet. The CNI extension adds its plugins to /usr/lib/cni, the one
#     directory containerd's bin_dirs lists.
#  5. For each merged file, Kubernetes first, then CNI, the line
#     `sha256sum <component>_<version>.raw` prints in /var/lib/extensions
#     ("<sha256>  <file>", the same line the published SHA256SUMS carries) is
#     measured into PCR 13 with systemd-pcrextend: PCR 13 := sha256(PCR 13 ||
#     sha256(line)). The only other PCR 13 event of a boot is the initrd's
#     "os-separator", so the host computes the value from the published
#     sha256 of each file (images/scripts/verify-sysext writes them to
#     policy.json as sysexts.<component>.<version>; attest.SysextPCR).
#  6. The node stack is made usable for units ordered After=vm-kubernetes.service
#     (the kubeadm unit from CAPI's Ignition config): on a boot that downloaded
#     the extension, systemd-modules-load.service and systemd-sysctl.service
#     ran before it existed, so its modules-load.d/ (br_netfilter) and sysctl.d/
#     (net.ipv4.ip_forward, bridge-nf-call-iptables) are applied now; and the
#     Upholds= start of containerd is waited for, so the CRI socket kubeadm's
#     preflight dials is there when this unit is active. kubelet is left to
#     its restart loop until kubeadm configures it.
#
# A different version on a later boot replaces the file and the merge; PCR 13
# then carries the new versions only, because this runs once per boot and
# measures after the final merge.
set -euo pipefail
shopt -s nullglob

extensions=/var/lib/extensions
pcr=13

log() { echo "vm-kubernetes: $*"; }
fail() { echo "vm-kubernetes: $*" >&2; exit 1; }

# imds_version <key> sets $version to the value of an IMDS key, empty when
# the key is unset, and $reason to why it is unset. systemd-imds exits 1 on
# every error; stderr tells them apart. systemd-imdsd's KeyNotFound for an
# unset key (vm-manager's bodyless 404: the VM was created without that
# version) prints as "Key not available." (the tool maps KeyNotFound and
# WellKnownKeyUnset to that line, src/imds/imds-tool.c); NotSupported, when no
# IMDS provider matched the machine (a boot outside vm-manager, e.g.
# scripts/smoke-boot), prints its varlink error name. Both mean there is
# nothing to pull; CommunicationFailure, Timeout and NotAvailable are failures
# of a VM that should have a version.
imds_version() {
        local key="$1" err=/run/vm-kubernetes.imds-err
        local nothing_to_pull='^Key not available\.$|InstanceMetadata\.NotSupported'
        reason="empty"
        if ! version="$(/usr/lib/systemd/systemd-imds "$key" 2>"$err")"; then
                version=""
                reason="$(/usr/bin/grep -m1 -o -E "$nothing_to_pull" "$err")" \
                        || fail "cannot read $key from the IMDS: $(tr '\n' ' ' <"$err")"
        fi
        version="${version//[[:space:]]/}"
}

# pull <component> <version> leaves exactly <component>_<version>.raw of the
# component in /var/lib/extensions, downloading it when absent.
pull() {
        local component="$1" version="$2" name="$1_$2.raw" f start ms
        for f in "$extensions/$component"_*.raw; do
                [[ "${f##*/}" == "$name" ]] && continue
                log "removing superseded ${f##*/}"
                rm -f "$f"
        done
        if [[ -s "$extensions/$name" ]]; then
                log "$name is present, no download"
                return
        fi
        # EPOCHREALTIME is seconds with six decimals; strip the point for
        # microsecond integer arithmetic (the base image has no awk or bc).
        start=${EPOCHREALTIME/./}
        /usr/lib/systemd/systemd-sysupdate --component="$component" update "$version"
        [[ -s "$extensions/$name" ]] || fail "systemd-sysupdate did not install $name"
        ms=$(( (${EPOCHREALTIME/./} - start) / 1000 ))
        log "pulled $name ($(stat -c %s "$extensions/$name") bytes) in $((ms / 1000)).$(printf '%03d' $((ms % 1000))) s"
}

imds_version /kubernetes-version
kubernetes="$version"
[[ -n "$kubernetes" ]] || { log "no /kubernetes-version from the IMDS ($reason), this VM runs without Kubernetes"; exit 0; }
imds_version /cni-version
cni="$version"

# The order of measured is the order of PCR 13's events.
measured=("kubernetes_$kubernetes")
pull kubernetes "$kubernetes"
if [[ -n "$cni" ]]; then
        measured+=("cni_$cni")
        pull cni "$cni"
else
        log "no /cni-version from the IMDS ($reason): removing any cni_*.raw, containerd has the reference plugins only"
        rm -f "$extensions"/cni_*.raw
fi

systemd-sysext refresh
# Exactly our images may be merged on /usr and present in any extension
# directory, as systemd-sysext itself reports them (status: what it merged per
# hierarchy; list: every image it finds in /etc/extensions, /run/extensions,
# /var/lib/extensions, /usr/lib/extensions, ...). Every extension-release file
# in the merged /usr must belong to a merged image: a file another image
# carries cannot make an extension look merged.
want="$(printf '%s\n' "${measured[@]}" | sort | paste -sd,)"
merged="$(systemd-sysext status --json=short --no-pager \
        | jq -r '.[] | select(.hierarchy == "/usr") | .extensions | if type == "array" then .[] else empty end' | sort | paste -sd,)"
[[ "$merged" == "$want" ]] || fail "systemd-sysext merged '${merged:-nothing}' on /usr, want '$want'"
present="$(systemd-sysext list --json=short --no-pager | jq -r '.[].name' | sort | paste -sd,)"
[[ "$present" == "$want" ]] || fail "the extension directories hold '${present:-nothing}', want only '$want'"
for f in /usr/lib/extension-release.d/extension-release.*; do
        [[ ",$merged," == *",${f##*/extension-release.},"* ]] || fail "$f names no merged image (merged: $merged)"
done

for name in "${measured[@]}"; do
        line="$(cd "$extensions" && sha256sum "$name.raw")"
        /usr/lib/systemd/systemd-pcrextend --pcr="$pcr" "$line"
        log "measured '$line' into PCR $pcr"
done

# Modules first: net.bridge.* exists only once br_netfilter is loaded. Both
# are no-ops on a boot where systemd-sysext.service merged the extension early.
systemctl restart systemd-modules-load.service systemd-sysctl.service
systemctl start containerd.service
log "${measured[*]} active: modules and sysctls applied, containerd started"
