[Unit]
Description=Install the booted OS onto the vm-manager target disk
Documentation=man:systemd-sysinstall(8)
# vm-manager passes vm.install-target (a /dev/disk/by-id path) through SMBIOS
# type 11 only for the installer boot; every other boot skips this unit.
ConditionCredential=vm.install-target
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service local-fs.target systemd-tpm2-setup.service systemd-imds-import.service

[Service]
Type=oneshot
ExecStart=/usr/lib/vm-manager/sysinstall
# systemd tools running as a service log straight to the journal. The
# installer system is discarded on reboot and its serial console is the one
# artifact vm-manager keeps, so systemd-sysinstall, systemd-repart and
# bootctl (varlink children inheriting the environment) log to stderr and
# thereby to the console as well.
Environment=SYSTEMD_LOG_TARGET=console
ImportCredential=vm.*
ImportCredential=firstboot.*
ImportCredential=ssh.*
ImportCredential=system.*
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
