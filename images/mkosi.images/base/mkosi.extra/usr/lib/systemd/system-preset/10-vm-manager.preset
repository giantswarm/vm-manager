# Unit policy of giantswarm-vm-base. mkosi runs `systemctl preset-all` in every
# image it builds (the base tree and the disk image), so enablement has to be
# expressed as presets rather than as symlinks created in a post-install script.
enable systemd-networkd.service
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable systemd-imdsd.socket
enable systemd-sysext.service
enable vm-kubernetes.service
enable vm-agent-attest.service
enable sshd.service
enable vm-sysinstall.service
enable vm-report-upload.timer
# The exitrd's view of the root file system, see run-initramfs-root.mount.
enable run-initramfs-root.mount
enable run-initramfs-usr.mount
# vm-manager triggers OS and kubernetes updates itself.
disable systemd-sysupdate.timer
disable systemd-sysupdate-reboot.timer
# vm-kubernetes merges the Kubernetes and CNI sysexts once, after it pulled
# both. systemd-sysupdate notifies this socket after every update it installs,
# and systemd-sysext would then refresh after each pull: the Kubernetes
# extension alone first, whose manager reload lets Upholds= start containerd
# and kubelet from a /usr without the CNI extension, then both, leaving the
# first merge's loop and verity device to whatever was started from it.
disable systemd-sysupdate-notify-sysext.socket
# Not part of a single-purpose VM image.
disable systemd-homed.service
disable systemd-homed-activate.service
disable machines.target
disable remote-cryptsetup.target
disable remote-integritysetup.target
disable remote-veritysetup.target
