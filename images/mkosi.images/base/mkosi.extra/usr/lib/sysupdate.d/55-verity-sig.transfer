[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=http://169.254.169.254/giantswarm/v1/sysupdate/base/
MatchPattern=giantswarm-vm-base_@v.verity-sig.raw

[Target]
Type=partition
Path=auto
MatchPattern=giantswarm-vm-base_@v_verity_sig
MatchPartitionType=root-verity-sig
PartitionFlags=0
ReadOnly=1
