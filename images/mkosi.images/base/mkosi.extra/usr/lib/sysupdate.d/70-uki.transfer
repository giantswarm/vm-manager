# The UKI is written last (alphabetical transfer order) so a new boot entry
# only appears once its root and verity partitions are in place.
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=http://169.254.169.254/giantswarm/v1/sysupdate/base/
MatchPattern=giantswarm-vm-base_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=giantswarm-vm-base_@v+@l-@d.efi \
             giantswarm-vm-base_@v+@l.efi \
             giantswarm-vm-base_@v.efi
Mode=0644
TriesLeft=3
TriesDone=0
InstancesMax=2
