{
  // Repo-specific Renovate rules for vm-manager. Pulled in as the last `extends`
  // entry of the generated renovate.json5; class-wide rules belong in
  // giantswarm/renovate-presets.
  customManagers: [
    {
      // An Ubuntu package the Dockerfile pins through an ARG, announced by the
      // comment above it:
      //   # renovate: suite=resolute-updates depName=ovmf-generic
      //   ARG OVMF_GENERIC_VERSION=2025.11-3ubuntu7.2
      // The suite is the archive pocket that carries the package's newest
      // build (updates also receives every security update).
      customType: 'regex',
      description: 'Ubuntu packages pinned through a Dockerfile ARG',
      managerFilePatterns: ['/^Dockerfile$/'],
      matchStrings: [
        '#\\s*renovate:\\s*suite=(?<suite>\\S+)\\s+depName=(?<depName>\\S+)\\s+ARG\\s+\\w+=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'deb',
      versioningTemplate: 'deb',
      registryUrlTemplate: 'https://archive.ubuntu.com/ubuntu?suite={{suite}}&components=main&binaryArch=amd64',
    },
    {
      // The CNI release a cni sysext is built from, one entry per CNI in
      // images/cni/, announced by the comment above it:
      //   # renovate: datasource=github-releases depName=flannel-io/cni-plugin
      //   release=v1.9.1-flannel3
      // flannel's tags carry a -flannel<n> rebuild suffix, compared as the
      // build number rather than a pre-release.
      customType: 'regex',
      description: 'CNI releases of the cni sysexts (images/cni/<name>)',
      managerFilePatterns: ['/^images/cni/[^/]+$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+release=(?<currentValue>\\S+)',
      ],
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-[a-z]+(?<build>\\d+))?$',
    },
    {
      // The containerd release of the kubernetes sysext, an OCI artifact of
      // the Giant Swarm line pinned by tag and digest in images/Makefile,
      // announced by the comment above it:
      //   # renovate: datasource=docker depName=gsoci.azurecr.io/giantswarm/containerd
      //   CONTAINERD_IMAGE   := gsoci.azurecr.io/giantswarm/containerd:v2.4.2-gs.2@sha256:…
      // Tag and digest are bumped together. The line's tags are the upstream
      // release with a -gs.<n> suffix, compared as the build number rather
      // than a pre-release.
      customType: 'regex',
      description: 'containerd release of the kubernetes sysext (images/Makefile)',
      managerFilePatterns: ['/^images/Makefile$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+\\w+\\s*:=\\s*[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-gs\\.(?<build>\\d+)$',
    },
  ],
  packageRules: [
    {
      // A CNI entry pins its asset's sha256 next to the release: the bump
      // fails the image build until the new value is in, which the build
      // prints (scripts/fetch-cni-plugins).
      description: 'A CNI release bump needs the asset sha256 in its images/cni entry',
      matchFileNames: ['images/cni/**'],
      prBodyNotes: [
        '**The entry pins the asset\'s sha256.** Set `sha256=` in the `images/cni/` file to the new release\'s value: `make -C images cni-plugins` fails and prints it, or `curl -fsSL <url> | sha256sum`.',
      ],
    },
    {
      // gvisor-tap-vsock is taken from main (a v0.8.9-0.<date>-<sha>
      // pseudo-version) for a gvisor that carries CVE-2026-96812's fix. v0.8.9
      // sorts above it, but its UDP forwarder predates gvisor's handler change
      // and does not build against that gvisor.
      description: 'gvisor-tap-vsock: never back to v0.8.9, which does not build against a gvisor with the CVE-2026-96812 fix',
      matchDatasources: ['go'],
      matchPackageNames: ['github.com/containers/gvisor-tap-vsock'],
      allowedVersions: '>0.8.9',
    },
    {
      // gvisor is taken by hand from its `go` branch, the generated tree Go
      // builds. The go datasource's digest update follows the proxy's @latest,
      // a commit on master, whose packages do not build as a Go module.
      description: 'gvisor: no digest updates; a new commit is taken by hand from its go branch',
      matchDatasources: ['go'],
      matchPackageNames: ['gvisor.dev/gvisor'],
      matchUpdateTypes: ['digest'],
      enabled: false,
    },
    {
      // ovmf-generic is the firmware every VM boots with and PCR 0 measures
      // it: golden PCR values recorded under one build fail under the next.
      // The subject is the release note, so it says so.
      description: 'A new OVMF build invalidates recorded golden PCR values; its pull request and release note say so',
      matchDatasources: ['deb'],
      matchPackageNames: ['ovmf-generic'],
      commitMessageTopic: 'OVMF',
      commitMessageExtra: 'to {{{newVersion}}}, re-record golden PCRs',
      prBodyNotes: [
        '**Firmware change: golden PCR values must be recorded again.** `ovmf-generic` is the OVMF build every VM boots with, and PCR 0 measures it. Golden values recorded under the current build fail every quote under this one (`golden mismatch: pcr 0`), and a VM created with attestation required never receives its user-data. After this release, record the values again for every image in use: README, section Attestation, "Recording golden values again".',
      ],
    },
  ],
}
