[Unit]
Description=vm-manager - systemd-native VM provisioner (REST + MCP)
Documentation=https://github.com/giantswarm/vm-manager
Documentation=https://github.com/giantswarm/vm-manager/blob/main/docs/install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vm-manager
Group=vm-manager
# /dev/kvm and /dev/vhost-vsock are root:kvm 0660 on most distributions
# (see docs/install.md for the vhost-vsock udev rule).
SupplementaryGroups=kvm

# Every serve flag has a VM_MANAGER_* environment fallback; put overrides
# (OAuth, timeouts, the listen address) into /etc/vm-manager/env. Flags on
# the command line win over the environment.
EnvironmentFile=-/etc/vm-manager/env
ExecStart=/usr/local/bin/vm-manager serve \
    --state-dir=/var/lib/vm-manager \
    --image-dir=/var/lib/vm-manager/images \
    --listen=127.0.0.1:8080

# Restarts. VMs survive them: QEMU and swtpm run as transient units of the
# vm-manager user's own service manager (vm-manager-<id>-qemu/-swtpm in
# vm-manager.slice under user@<uid>.service), not in this unit's cgroup.
# On stop vm-manager detaches (--detach-vms-on-exit, default) and the next
# start reattaches through the records in the state dir. That user manager
# exists only with lingering enabled: `loginctl enable-linger vm-manager`
# (docs/install.md). Without it vm-manager falls back to plain child
# processes, logs a warning, and then every VM is powered down when the
# service stops (ACPI, then SIGTERM/SIGKILL after --stop-timeout) and comes
# back `stopped`; start_vm boots it again.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
# SIGTERM to vm-manager only. Matters for the child-process fallback: the
# children must outlive the signal long enough for the guests to power
# down. With the launcher the VMs are not in this cgroup at all.
KillMode=mixed

# Directories. StateDirectory= is the --state-dir above (VM records, disks
# when no storage provider is present, consoles, vTPM state, unix sockets);
# RuntimeDirectory= is free for sockets a reverse proxy may want.
StateDirectory=vm-manager
StateDirectoryMode=0750
RuntimeDirectory=vm-manager
RuntimeDirectoryMode=0750
UMask=0027
LimitNOFILE=65536

# Hardening. vm-manager itself needs AF_VSOCK for the guests' READY=1,
# AF_UNIX for its sockets under the state directory, systemd-run/systemctl
# against the user manager at /run/user/<uid> (reachable: ProtectHome= does
# not cover /run/user, and the launcher sets XDG_RUNTIME_DIR itself), and to
# connect to the systemd storage provider's socket under
# /run/systemd/io.systemd.StorageProvider/ (a connect() to a unix socket
# works on the read-only view ProtectSystem=strict leaves). QEMU and swtpm
# run outside this sandbox under the user manager, so they get /dev/kvm and
# /dev/vhost-vsock through the vm-manager user's kvm group membership
# (sysusers.d); the DeviceAllow= lines below serve the child-process
# fallback only.
# Not set on purpose: MemoryDenyWriteExecute= (QEMU), ProcSubset=pid
# (get_host reads /proc/meminfo, the metrics read the QEMU processes),
# PrivateDevices= and PrivateNetwork= (the devices and the vsock transport).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/vhost-vsock rw
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_VSOCK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
